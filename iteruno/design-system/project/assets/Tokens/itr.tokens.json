      "fw-regular": {
        "$type": "dimension",
        "$value": "400",
        "$description": ""
      },
      "fw-medium": {
        "$type": "dimension",
        "$value": "500",
        "$description": ""
      },
      "fw-semibold": {
        "$type": "dimension",
        "$value": "600",
        "$description": ""
      },
      "fw-bold": {
        "$type": "dimension",
        "$value": "700",
        "$description": ""
