      "ls-label": {
        "$type": "dimension",
        "$value": "0.08em",
        "$description": "Rótulos em caixa alta."
      },
      "ls-display": {
        "$type": "dimension",
        "$value": "0.01em",
        "$description": "Display em Saira Condensed."
      }
    },
    "breakpoint": {
      "bp-s": {
        "$type": "dimension",
        "$value": "360px",
        "$description": "Menor largura suportada."
      },
      "bp-m": {
        "$type": "dimension",
        "$value": "768px",
        "$description": "Tablet: duas colunas, menu completo."
      },
      "bp-l": {
        "$type": "dimension",
        "$value": "1200px",
        "$description": "Desktop: três colunas, largura máxima do conteúdo."
      }
    },
    "duration": {
      "duration-fast": {
        "$type": "duration",
        "$value": "120ms",
        "$description": "Hover e foco."
      },
      "duration-base": {
        "$type": "duration",
        "$value": "200ms",
        "$description": "Abrir e fechar menu, acordeão, alertas."
      },
      "ease-standard": {
        "$type": "duration",
        "$value": "cubic-bezier(0.2, 0, 0, 1)",
        "$description": "Curva padrão."
      }
    },
    "zIndex": {
      "z-sticky": {
        "$type": "number",
        "$value": "100",
        "$description": "Barra de navegação fixa."
      },
      "z-menu": {
        "$type": "number",
        "$value": "150",
        "$description": "Painel do menu no celular."
      },
      "z-dialog": {
        "$type": "number",
        "$value": "200",
        "$description": "Diálogos."
      },
      "z-toast": {
        "$type": "number",
        "$value": "300",
        "$description": "Avisos flutuantes."
      }
    },
    "fontFamily": {
      "display": {
        "$type": "fontFamily",
        "$value": "'Saira Condensed', 'Arial Narrow', 'Roboto Condensed', sans-serif"
      },
      "sans": {
        "$type": "fontFamily",
        "$value": "'Public Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "ui-monospace, 'Cascadia Mono', Menlo, Consolas, monospace"
      }
    },
    "typography": {
      "display-xl": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{iteruno.fontFamily.display}",
          "fontSize": "64px",
          "lineHeight": "64px",
          "fontWeight": 600,
          "letterSpacing": "0.01em"
        },
        "$description": "Promessa no Hero. No celular (até 767 px) cai para 40/42."
      },
      "display-l": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{iteruno.fontFamily.display}",
          "fontSize": "44px",
          "lineHeight": "48px",
          "fontWeight": 600,
          "letterSpacing": "0.01em"
        },
        "$description": "Título de página e de seção grande. No celular 32/36."
      },
      "title-1": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{iteruno.fontFamily.sans}",
          "fontSize": "28px",
          "lineHeight": "34px",
          "fontWeight": 700
        },
        "$description": "Título de seção."
      },
      "title-2": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{iteruno.fontFamily.sans}",
          "fontSize": "20px",
          "lineHeight": "26px",
          "fontWeight": 700
        },
        "$description": "Título de cartão e de bloco."
      },
      "body-l": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{iteruno.fontFamily.sans}",
          "fontSize": "18px",
          "lineHeight": "28px",
          "fontWeight": 400
        },
        "$description": "Parágrafo de abertura, apoio do Hero."
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{iteruno.fontFamily.sans}",
          "fontSize": "16px",
          "lineHeight": "24px",
          "fontWeight": 400
        },
        "$description": "Texto corrente, campos, botões."
      },
      "body-strong": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{iteruno.fontFamily.sans}",
          "fontSize": "16px",
          "lineHeight": "24px",
          "fontWeight": 600
        },
        "$description": "Rótulos de campo, botões, links."
      },
      "small": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{iteruno.fontFamily.sans}",
          "fontSize": "14px",
          "lineHeight": "20px",
          "fontWeight": 400
        },
        "$description": "Notas, dicas, metadados, rodapé."
      },
      "label": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{iteruno.fontFamily.sans}",
          "fontSize": "12px",
          "lineHeight": "16px",
          "fontWeight": 600,
          "letterSpacing": "0.08em"
        },
        "$description": "Rótulos pequenos em caixa alta (text-transform no CSS)."
      },
      "code": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{iteruno.fontFamily.mono}",
          "fontSize": "14px",
          "lineHeight": "22px",
          "fontWeight": 400
        },
        "$description": "Comandos e trechos de código nas apostilas."
      }
    }
