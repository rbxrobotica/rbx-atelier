      },
      "icon-xl": {
        "$type": "dimension",
        "$value": "32px",
        "$description": "Ícone em destaque nos cartões de serviço."
      },
      "border-hair": {
        "$type": "dimension",
        "$value": "1px",
        "$description": "Bordas e divisores."
      },
      "border-strong": {
        "$type": "dimension",
        "$value": "2px",
        "$description": "Foco, campo inválido, checkbox."
      },
      "content-max": {
        "$type": "dimension",
        "$value": "1200px",
        "$description": "Largura máxima do conteúdo (breakpoint l)."
      },
      "content-narrow": {
        "$type": "dimension",
        "$value": "760px",
        "$description": "Largura de texto corrido: Sobre, Política."
      },
      "card-min": {
        "$type": "dimension",
        "$value": "240px",
        "$description": "Largura mínima de cartão na grade automática."
      },
      "text-max": {
        "$type": "dimension",
        "$value": "68ch",
        "$description": "Medida máxima de um parágrafo."
      }
    },
    "typeScale": {
      "fs-display-xl": {
