        "$description": ""
      },
      "fs-code": {
        "$type": "dimension",
        "$value": "14px",
        "$description": ""
      },
      "lh-display-xl": {
        "$type": "dimension",
        "$value": "64px",
        "$description": ""
      },
      "lh-display-xl-m": {
        "$type": "dimension",
        "$value": "42px",
        "$description": ""
      },
      "lh-display-l": {
        "$type": "dimension",
        "$value": "48px",
        "$description": ""
      },
      "lh-display-l-m": {
        "$type": "dimension",
        "$value": "36px",
        "$description": ""
      },
      "lh-title-1": {
        "$type": "dimension",
        "$value": "34px",
        "$description": ""
      },
      "lh-title-2": {
        "$type": "dimension",
        "$value": "26px",
        "$description": ""
      },
      "lh-body-l": {
        "$type": "dimension",
        "$value": "28px",
        "$description": ""
      },
      "lh-body": {
