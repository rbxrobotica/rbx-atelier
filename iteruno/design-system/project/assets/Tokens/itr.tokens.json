{
  "$schema": "https://www.designtokens.org/schemas/2024/10/tokens.json",
  "iteruno": {
    "color": {
      "fundo": {
        "$type": "color",
        "$value": {
          "claro": "#f3f7f5",
          "escuro": "#0c1714"
        },
        "$description": "Fundo da página."
      },
      "superficie": {
        "$type": "color",
        "$value": {
          "claro": "#ffffff",
          "escuro": "#142019"
        },
        "$description": "Cartões, campos, barra de navegação, rodapé."
      },
      "superficie-2": {
        "$type": "color",
        "$value": {
          "claro": "#e8efeb",
          "escuro": "#0a1210"
        },
        "$description": "Áreas rebaixadas: fundo de código, campos desabilitados, faixas alternadas."
      },
      "linha": {
        "$type": "color",
        "$value": {
          "claro": "#d7e2dd",
          "escuro": "#243730"
        },
        "$description": "Divisores e bordas de cartões."
      },
      "borda-campo": {
        "$type": "color",
        "$value": {
          "claro": "#6b7c76",
          "escuro": "#6e857c"
        },
        "$description": "Borda de campos e de botões secundários: 3:1 sobre fundo e superfície."
      },
      "texto": {
        "$type": "color",
        "$value": {
          "claro": "#16231f",
          "escuro": "#e6f0ec"
        },
        "$description": "Texto principal e títulos."
      },
      "texto-2": {
        "$type": "color",
        "$value": {
          "claro": "#4d5b56",
          "escuro": "#a8b8b1"
        },
        "$description": "Texto de apoio, descrições, rótulos secundários."
      },
      "texto-3": {
        "$type": "color",
        "$value": {
          "claro": "#5f6f69",
          "escuro": "#8a9a93"
        },
        "$description": "Dicas, placeholders, metadados. Contraste mínimo para texto."
      },
      "marca": {
        "$type": "color",
        "$value": {
          "claro": "#008066",
          "escuro": "#35c4a0"
        },
        "$description": "Verde Iteruno: botão primário, links sobre fundo e superfície, ícones de destaque."
      },
      "marca-forte": {
        "$type": "color",
        "$value": {
          "claro": "#00563f",
          "escuro": "#7adfc4"
        },
        "$description": "Hover do primário; texto da marca sobre marca-suave ou superfície-2."
      },
      "marca-suave": {
        "$type": "color",
        "$value": {
          "claro": "#e3f5ee",
          "escuro": "#163a30"
        },
        "$description": "Fundos leves da marca: link ativo, ícone em cartão, botão fantasma em hover."
      },
      "sobre-marca": {
        "$type": "color",
        "$value": {
          "claro": "#ffffff",
          "escuro": "#0c1714"
        },
        "$description": "Texto e ícones sobre marca e marca-forte."
      },
      "sucesso": {
        "$type": "color",
        "$value": {
          "claro": "#1e6b45",
          "escuro": "#6fd39b"
        },
        "$description": "Estado de sucesso: texto, ícone, borda."
      },
      "sucesso-suave": {
        "$type": "color",
        "$value": {
          "claro": "#e1f3e8",
          "escuro": "#14301f"
        },
        "$description": "Fundo de alertas e badges de sucesso."
      },
      "aviso": {
        "$type": "color",
        "$value": {
          "claro": "#9a5b00",
          "escuro": "#e8b65a"
        },
        "$description": "Estado de aviso: texto, ícone, borda."
      },
      "aviso-suave": {
        "$type": "color",
        "$value": {
          "claro": "#fbeedc",
          "escuro": "#33270c"
        },
        "$description": "Fundo de alertas e badges de aviso."
      },
      "erro": {
        "$type": "color",
        "$value": {
          "claro": "#b3261e",
          "escuro": "#f08a98"
        },
        "$description": "Erro e ações destrutivas: texto, ícone, borda de campo inválido."
      },
      "erro-suave": {
        "$type": "color",
        "$value": {
          "claro": "#fbe5e3",
          "escuro": "#3a1419"
        },
        "$description": "Fundo de alertas e badges de erro."
      },
      "info": {
        "$type": "color",
        "$value": {
          "claro": "#1d4f91",
          "escuro": "#8db4f0"
        },
        "$description": "Informação neutra: texto, ícone, borda."
      },
      "info-suave": {
        "$type": "color",
        "$value": {
          "claro": "#e2eaf5",
          "escuro": "#16243a"
        },
        "$description": "Fundo de alertas e badges de informação."
      },
      "foco": {
        "$type": "color",
        "$value": {
          "claro": "{iteruno.color.marca}",
          "escuro": "{iteruno.color.marca}"
        },
        "$description": "Anel de foco: 2 px sólidos, afastados 2 px, em todo elemento interativo."
      },
      "veu": {
        "$type": "color",
        "$value": {
          "claro": "rgba(22, 35, 31, 0.56)",
          "escuro": "rgba(0, 0, 0, 0.64)"
        },
        "$description": "Véu atrás do menu aberto no celular e de diálogos."
      }
    },
    "shadow": {
      "shadow-1": {
        "$type": "shadow",
        "$value": {
          "claro": "0 1px 2px rgba(22, 35, 31, 0.08)",
          "escuro": "0 1px 2px rgba(0, 0, 0, 0.4)"
        },
        "$description": "Cartão destacado em repouso."
      },
      "shadow-2": {
        "$type": "shadow",
        "$value": {
          "claro": "0 8px 24px rgba(22, 35, 31, 0.14)",
          "escuro": "0 8px 24px rgba(0, 0, 0, 0.5)"
        },
        "$description": "Menu aberto, diálogos."
      }
    },
    "spacing": {
      "space-1": {
        "$type": "dimension",
        "$value": "4px",
        "$description": "Entre ícone e texto."
      },
      "space-2": {
        "$type": "dimension",
        "$value": "8px",
        "$description": "Entre rótulo e campo; gap de chips."
      },
      "space-3": {
        "$type": "dimension",
        "$value": "12px",
        "$description": "Padding de badges; gap de listas."
      },
      "space-4": {
        "$type": "dimension",
        "$value": "16px",
        "$description": "Padding horizontal de campos; gap entre campos."
      },
      "space-5": {
        "$type": "dimension",
        "$value": "20px",
        "$description": "Padding horizontal de botões."
      },
      "space-6": {
        "$type": "dimension",
        "$value": "24px",
        "$description": "Padding de cartões; margem lateral no celular."
      },
      "space-8": {
        "$type": "dimension",
        "$value": "32px",
        "$description": "Entre blocos de uma seção."
      },
      "space-10": {
        "$type": "dimension",
        "$value": "40px",
        "$description": "Padding vertical de seções no celular."
      },
      "space-12": {
        "$type": "dimension",
        "$value": "48px",
        "$description": "Entre seções."
      },
      "space-16": {
        "$type": "dimension",
        "$value": "64px",
        "$description": "Padding vertical de seções no desktop."
      },
      "space-20": {
        "$type": "dimension",
        "$value": "80px",
        "$description": "Hero no desktop."
      },
      "space-24": {
        "$type": "dimension",
        "$value": "96px",
        "$description": "Respiro máximo."
      }
    },
    "radius": {
      "radius-s": {
        "$type": "dimension",
        "$value": "4px",
        "$description": "Badges, código, checkbox."
      },
      "radius-m": {
        "$type": "dimension",
        "$value": "8px",
        "$description": "Botões, campos, alertas."
      },
      "radius-l": {
        "$type": "dimension",
        "$value": "12px",
        "$description": "Cartões, faixas, imagens."
      },
      "radius-pill": {
        "$type": "dimension",
        "$value": "999px",
        "$description": "Pílulas e avatar."
      }
    },
    "size": {
      "control-s": {
        "$type": "dimension",
        "$value": "36px",
        "$description": "Botão pequeno."
      },
      "control-m": {
        "$type": "dimension",
        "$value": "44px",
        "$description": "Botão, campo e alvo de toque padrão (mínimo 44 px)."
      },
      "control-l": {
        "$type": "dimension",
        "$value": "52px",
        "$description": "Botão grande do Hero e do ContactCTA."
      },
      "icon-s": {
        "$type": "dimension",
        "$value": "16px",
        "$description": "Ícone em texto pequeno e badges."
      },
      "icon-m": {
        "$type": "dimension",
        "$value": "20px",
        "$description": "Ícone em botões e campos."
      },
      "icon-l": {
        "$type": "dimension",
        "$value": "24px",
