{
  "name": "Satwake",
  "version": "0.1.0",
  "prefix": "sw",
  "color": {
    "bg":            { "$type": "color", "$value": "#F7F5F0", "$description": "Papel, fundo padrão" },
    "surface":       { "$type": "color", "$value": "#FFFFFF", "$description": "Cartões, formulários" },
    "sunken":        { "$type": "color", "$value": "#EEEAE1", "$description": "Faixas, cabeçalho de tabela" },
    "ink":           { "$type": "color", "$value": "#1E2227", "$description": "Texto principal, 14.7:1 sobre bg" },
    "ink-2":         { "$type": "color", "$value": "#474D56", "$description": "Texto secundário, 7.8:1 sobre bg" },
    "ink-3":         { "$type": "color", "$value": "#626873", "$description": "Legendas, 5.1:1 sobre bg" },
    "line":          { "$type": "color", "$value": "#DAD5CA", "$description": "Divisores decorativos, nunca borda de campo" },
    "field":         { "$type": "color", "$value": "#8A8375", "$description": "Borda de campo e controle, 3.8:1 sobre surface" },
    "action":        { "$type": "color", "$value": "#B4461A", "$description": "Aurora, única cor de ação; branco sobre ela 5.5:1" },
    "action-strong": { "$type": "color", "$value": "#963815", "$description": "Hover e texto de destaque; branco 7.3:1" },
    "action-soft":   { "$type": "color", "$value": "#F6E3D6", "$description": "Fundo suave; texto sobre ele usa action-strong" },
    "sunrise":       { "$type": "color", "$value": "#E07A3F", "$description": "Nascente, decorativo apenas, nunca texto" },
    "first-light":   { "$type": "color", "$value": "#E8B04A", "$description": "Primeira luz, decorativo apenas, nunca texto" },
    "predawn":       { "$type": "color", "$value": "#26456B", "$description": "Madrugada: links, dados, anel de foco; 9.0:1 sobre bg, branco sobre ela 9.8:1" },
    "predawn-soft":  { "$type": "color", "$value": "#DCE5EF", "$description": "Selos informativos" },
    "ok":            { "$type": "color", "$value": "#2F6B45" },
    "ok-soft":       { "$type": "color", "$value": "#E6F1EA" },
    "warn":          { "$type": "color", "$value": "#8A5A00" },
    "warn-soft":     { "$type": "color", "$value": "#FBF1DC" },
    "err":           { "$type": "color", "$value": "#A3283A", "$description": "Erro, sempre com ícone e texto" },
    "err-soft":      { "$type": "color", "$value": "#FBEDEF" },
    "night":         { "$type": "color", "$value": "#1E2227", "$description": "Seções escuras: amostra, CTA final" }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": ["Newsreader", "Georgia", "serif"] },
    "sans":    { "$type": "fontFamily", "$value": ["IBM Plex Sans", "system-ui", "sans-serif"] },
    "mono":    { "$type": "fontFamily", "$value": ["IBM Plex Mono", "ui-monospace", "monospace"] }
  },
  "type": {
    "display-xl": { "size": "64px", "line": 1.05, "weight": 500, "family": "display", "mobile": "40px" },
    "display-l":  { "size": "48px", "line": 1.1,  "weight": 500, "family": "display", "mobile": "32px" },
    "title-1":    { "size": "36px", "line": 1.2,  "weight": 500, "family": "display", "mobile": "28px" },
    "title-2":    { "size": "26px", "line": 1.25, "weight": 600, "family": "display", "mobile": "22px" },
    "body-l":     { "size": "19px", "line": 1.6,  "weight": 400, "family": "sans", "mobile": "17px" },
    "body":       { "size": "16px", "line": 1.6,  "weight": 400, "family": "sans" },
    "small":      { "size": "14px", "line": 1.55, "weight": 400, "family": "sans" },
    "label":      { "size": "12px", "line": 1.4,  "weight": 400, "family": "mono", "transform": "uppercase", "tracking": "0.08em" }
  },
  "space":  { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px", "9": "96px", "10": "128px" },
  "radius": { "s": "6px", "m": "8px", "l": "16px", "pill": "999px" },
  "shadow": { "1": "0 1px 2px rgba(30,34,39,0.06)", "2": "0 12px 32px rgba(30,34,39,0.08)" },
  "motion": { "fast": "120ms", "base": "200ms", "ease": "cubic-bezier(0.2, 0.7, 0.2, 1)", "reduced": "0ms" },
  "focus":  { "ring": "2px solid #26456B", "offset": "2px" },
  "layout": { "container": "1200px", "gutter": "24px", "gutter-mobile": "20px", "measure": "68ch", "breakpoints": ["640px", "960px", "1200px"], "touch-target": "44px" }
}
